# StockInvestmentTool 环境变量配置
# 复制本文件为 .env 并填入实际值

# DeepSeek API Key（必填，如需使用 --api 功能）
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek API 地址（可选，默认即可）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型（可选，默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# Web 端口（可选，默认 8090；本机 Docker 的 spark-master 占用 8080，勿用）
# STOCK_WEB_PORT=8090

# ══ 消息提醒（notifier 模块）══════════════════════════════
# 渠道: feishu（飞书） | wecom（企业微信） | email（邮件）
# NOTIFY_CHANNEL=feishu

# ── 邮件渠道（NOTIFY_CHANNEL=email 时使用）──────────────
# QQ 邮箱: 设置 → 账户 → 开启 SMTP 服务 → 生成授权码
# EMAIL_SMTP_HOST=smtp.qq.com
# EMAIL_SMTP_PORT=465
# EMAIL_USER=你的QQ邮箱
# EMAIL_PASSWORD=SMTP授权码
# EMAIL_TO=收件人邮箱,多个用逗号分隔
# 失败/超时任务邮件必须配置 EMAIL_TO；事件先写入 notification outbox，由 worker 异步投递。

# 飞书群机器人 webhook（飞书里建群 → 添加自定义机器人获取）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# 企业微信群机器人 webhook（企业微信里建群 → 添加机器人获取）
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# ══ 登录认证（配置后 web 启用登录校验；不配则免登录开发模式）══
# ADMIN_USER=admin
# ADMIN_PASSWORD=你的密码
# SECRET_KEY=一段随机字符串（生产必填）
# STOCK_DISABLE_AUTH=1   # 临时关闭登录校验；仅在明确授权时启用

# ══ 每日自动任务（APScheduler，Asia/Shanghai 时区）═════════
# 每天 HH:MM 自动执行: 持仓刷新 → 持仓进自选 → 观察池重算 → 生成晨报 → 消息推送
# DAILY_RUN_TIME=15:35
# DISABLE_SCHEDULER=1   # 设为 1 可关闭定时任务

# ══ 盘中持仓操作提醒（实时推送有操作建议的持仓）══════════
# 刷新持仓，仅当某只触发「右侧止盈/止损/加仓/调止损」时推送飞书/企微
# POSITION_ACTIONABLE_NOTIFY=1   # 设为 1 开启
# POSITION_MONITOR_MINUTES=10     # 检查间隔（分钟）
# INTRADAY_NOTIFY_DAILY_LIMIT=3  # 普通盘中通知每天最多发送次数；检查间隔不等于发送频率

# ══ 数据仓库（warehouse 模块）══════════════════════════════
# 收盘后自动做「全市场日线增量同步 + 因子计算 + 新股PE/PB回补」（离线全量仓库）。
# 默认关闭；设为 1 开启。开盘期间请勿开启（会在盘中拉全量日线）。
# WAREHOUSE_DAILY_SYNC=1
# 每次定时日线采集的任务级超时（秒），超时会留下 partial/failed 记录并由 outbox 通知。
# WAREHOUSE_DAILY_TIMEOUT=3600
# 腾讯 HTTP 单请求超时（秒），默认 15；不改变串行限速。
# TENCENT_HTTP_TIMEOUT=15
# 定时采集请求间隔（秒），默认 0.3。
# BAOSTOCK_QUERY_INTERVAL=0.3
# 历史深度（年），默认 3；首建决定全量回补长度，建议 3-5。
# WAREHOUSE_YEARS=3
# 盘中观察池在线快照（分钟采集未启用时的兜底，每 10 分钟一次）。
# 设为 1 开启；默认关闭。与 WAREHOUSE_MINUTE_SNAPSHOT 互斥，分钟采集优先。
# WAREHOUSE_ONLINE_SNAPSHOT=1
# 盘中腾讯 1 分钟数据（每 1 分钟刷新，观察池范围，默认关闭）。
# WAREHOUSE_MINUTE_SNAPSHOT=1

# 独立 iTick 观察池分钟捞取（不接入 warehouse/minute 流程）。
# 每轮按游标最多抓取 4 只，串行间隔 15 秒，遵守免费 REST API 限制。
# ITICK_WATCHPOOL_ENABLED=1
# ITICK_WATCHPOOL_BATCH_SIZE=4
# ITICK_WATCHPOOL_INTERVAL_SECONDS=15
# ITICK_API_KEY_FILE=/home/ubuntu/.config/itick/api_key

# 分钟级止盈 V11：接入腾讯分钟链路，明日先 shadow/notify，不自动卖出。
# POSITION_V11_MODE=notify
# POSITION_V11_CANDIDATE_ATR=0.75
# POSITION_V11_SWING_ATR=0.75
# POSITION_V11_CONFIRMATION_BARS=3
# POSITION_V11_VOLUME_SURGE_RATIO=1.8
